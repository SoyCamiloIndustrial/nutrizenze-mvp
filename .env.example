# development | production (production exige SECRET_KEY y activa cookies seguras y HSTS)
APP_ENV=development
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 = crea usuarios demo (medico.demo, paciente.uno, paciente.dos) con datos ficticios
DEMO_MODE=1
# Contraseña de los usuarios demo (mínimo 12 caracteres en producción)
DEMO_PASSWORD=
# 1 = modo debug de Flask (solo local)
FLASK_DEBUG=0
PORT=5000
